# Fel7o Media — environment variables
# Copy this file to .env locally. Never commit .env.

# Required: generate a new token with @BotFather after revoking the exposed token.
BOT_TOKEN=
BOT_USERNAME=Fel7oMediaBot

# Optional: only needed for Spotify metadata/auth features.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:9876/callback
SPOTIFY_MONITOR_ENABLED=false
SPOTIFY_POLL_INTERVAL_SECONDS=21600

# Optional managed-host mode. Set the full HTTPS URL to enable Webhook mode.
# Leave WEBHOOK_URL empty for local long polling.
WEBHOOK_URL=
WEBHOOK_PATH=/telegram
WEBHOOK_SECRET=

# Optional administrator chat ID. Leave 0 to disable admin-only commands.
ADMIN_CHAT_ID=0

# Supported values: 128, 320, flac. 320 is the safe default for free hosting.
DEFAULT_BITRATE=320

# Optional paths; defaults are suitable for local execution.
# DOWNLOAD_DIR=
# TEMP_DIR=
# DATA_DIR=
