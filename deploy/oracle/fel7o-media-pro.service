[Unit]
Description=Fel7o Media Pro Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fel7o
Group=fel7o
WorkingDirectory=/opt/fel7o-media-pro
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/fel7o-media-pro/.venv/bin/python /opt/fel7o-media-pro/main.py
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
